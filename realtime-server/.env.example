# Copia a .env solo en local (no subir .env al repo).
# Producción: Render → conecta-realtime → Environment

PORT=10000

# Necesario para frases de señas + agente de ayuda DENTRO de Conecta
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Voz (opcional)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Zavu NO es necesario para Conecta (app propia).
# Solo si algún día quieres WhatsApp aparte: https://www.zavu.dev/es
# ZAVU_API_KEY=
