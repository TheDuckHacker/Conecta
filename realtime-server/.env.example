# Copia a .env solo en local (no subir .env al repo).
# Producción: Render → conecta-realtime → Environment

PORT=10000

# ============================================================
# Requeridas para Conecta
# ============================================================

# Necesario para frases de señas + agente de ayuda DENTRO de Conecta
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo opcional (por defecto gemini-2.0-flash-exp, fallback a gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.0-flash-exp

# Voz (opcional)
# Obtener en: https://elevenlabs.io
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ============================================================
# Seguridad (recomendado para producción)
# ============================================================

# Clave compartida para proteger endpoints HTTP sensibles
# Si está configurada, /ai/compose, /tts, /agent/help, /agent/zavu/send y /call/invite
# requieren el header: X-Conecta-Key: <tu-clave> o Authorization: Bearer <tu-clave>
# Si no está configurada, las rutas quedan abiertas (solo para desarrollo local)
# IMPORTANTE: Configura la misma clave en el cliente Flutter
CONECTA_API_KEY=

# ============================================================
# Zavu (WhatsApp/SMS) - OPCIONAL
# ============================================================

# Zavu NO es necesario para Conecta (app propia).
# Solo si algún día quieres WhatsApp aparte: https://www.zavu.dev/es
# ZAVU_API_KEY=
# ZAVU_SENDER_ID=
# ZAVU_WHATSAPP_NUMBER=
